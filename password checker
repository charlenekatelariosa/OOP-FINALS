<!DOCTYPE html>
<html>
<head>
    <title>Password Checker</title>

    <style>
        body {
            font-family: Arial;
            text-align: center;
            background: linear-gradient(135deg, #e6f2ff, #b3d9ff, #d9ccff);
            padding: 50px;
            animation: backgroundMove 6s infinite alternate;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 15px;
            max-width: 350px;
            margin: auto;
            box-shadow: 0 8px 25px rgba(0,0,0,0.15);
            animation: slideUp 1s ease;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .container:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.2);
        }

        h2 {
            color: #3366cc;
            animation: fadeIn 2s;
        }

        input, button {
            padding: 12px;
            margin: 10px;
            width: 85%;
            border-radius: 8px;
            box-sizing: border-box;
        }

        input {
            border: 2px solid #b3d9ff;
            outline: none;
            transition: 0.3s;
        }

        input:focus {
            border-color: #3366cc;
            box-shadow: 0 0 10px #b3d9ff;
        }

        button {
            background: linear-gradient(45deg, blue, #6699ff);
            color: white;
            border: none;
            cursor: pointer;
            font-weight: bold;
            transition: 0.3s;
        }

        button:hover {
            background: linear-gradient(45deg, #003399, #3366cc);
            transform: scale(1.05);
        }

        button:active {
            transform: scale(0.95);
        }

        #result {
            font-weight: bold;
            animation: fadeIn 0.5s;
        }

        .members {
            margin-top: 25px;
            color: #334466;
            font-size: 13px;
            line-height: 1.8;
            animation: fadeIn 2s;
        }

        .members h3 {
            color: #3366cc;
            font-size: 15px;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes backgroundMove {
            from { background-position: left; }
            to { background-position: right; }
        }
    </style>
</head>

<body>

<div class="container">
    <h2>Password Checker</h2>

    <input type="password" id="password"
           placeholder="Enter your password">

    <button onclick="checkPassword()">
        Check Password
    </button>

    <p id="result"></p>

    <div class="members">
        <h3>Developed by:</h3>
        Kathlene Faye Ramos<br>
        Shiela Grace Cabrera<br>
        Charlene Kate Lariosa
    </div>
</div>

<script>
function checkPassword() {
    let password =
        document.getElementById("password").value;

    let result = document.getElementById("result");

    if (password.length === 0) {
        result.innerHTML = "Please enter a password.";
        result.style.color = "black";
    }
    else if (password.length < 6) {
        result.innerHTML = "Weak Password";
        result.style.color = "red";
    }
    else if (password.length < 10) {
        result.innerHTML = "Medium Password";
        result.style.color = "orange";
    }
    else {
        result.innerHTML = "Strong Password";
        result.style.color = "green";
    }

    result.style.animation = "none";
    result.offsetHeight;
    result.style.animation = "fadeIn 0.5s";
}
</script>

</body>
</html>